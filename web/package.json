{
  "name": "lysilogy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/visual-smoke.mjs",
    "smoke:reader-tools": "node scripts/reader-tools-smoke.mjs",
    "test:paper-links": "node --experimental-strip-types --test scripts/paper-links.test.mjs",
    "smoke:link-hints": "node scripts/link-hints-smoke.mjs",
    "test:section-scope": "node --experimental-strip-types --test scripts/section-scope.test.mjs",
    "test:spatial-navigation": "node --experimental-strip-types --test scripts/spatial-navigation.test.mjs",
    "smoke:pipeline": "node scripts/pipeline-smoke.mjs",
    "test:source-text": "node --experimental-strip-types --test scripts/source-text.test.mjs",
    "test:reading-index-cache": "node --experimental-strip-types --test scripts/reading-index-cache.test.mjs",
    "test:section-figures": "node --experimental-strip-types --test scripts/section-figures.test.mjs",
    "smoke:source-search": "node scripts/source-search-smoke.mjs",
    "smoke:pdf-ink": "node scripts/pdf-ink-smoke.mjs",
    "smoke:paragraph-selection": "node scripts/paragraph-selection-smoke.mjs",
    "smoke:notes": "node scripts/notes-smoke.mjs",
    "test:vimrc": "node --experimental-strip-types --test scripts/vimrc.test.mjs",
    "smoke:notes-vimrc": "node scripts/notes-vimrc-smoke.mjs",
    "test:api": "node --experimental-strip-types --test scripts/api-response.test.mjs",
    "test:pdf-visual-bounds": "node --experimental-strip-types --test scripts/pdf-visual-bounds.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/language": "6.12.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.38.6",
    "@replit/codemirror-vim": "file:vendor/replit-codemirror-vim-6.4.0.tgz",
    "@replit/codemirror-vim-core": "file:vendor/replit-codemirror-vim-core-0.1.0.tgz",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
