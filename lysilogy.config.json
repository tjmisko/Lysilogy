{
  "vim": {
    "vimrc": ".vimrc"
  },
  "analysis": {
    "model": "deepseek/deepseek-v4.1-flash",
    "judgment_model": null,
    "providers": ["deepinfra"],
    "paper_budget_usd": 0.5,
    "label_model": null,
    "label_budget_usd": 0.1,
    "label_limit": 40
  },
  "notes": {
    "date_format": "YYYY-MM-DD",
    "time_format": "HH:mm",
    "tags": ["paper"],
    "template": "---\ndate: {{date}}\ntime: {{time}}\ntags:\n{{tags}}\n---\n\n## Sources\n- [{{source_title}}](<{{source_url}}>)\n"
  }
}
