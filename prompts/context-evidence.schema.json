{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "search_summary",
    "gaps"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "authors",
          "year",
          "url",
          "supports",
          "excerpt",
          "location",
          "relationship"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "authors": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1000,
            "maximum": 2100
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?://"
          },
          "supports": {
            "type": "string",
            "maxLength": 700
          },
          "excerpt": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "relationship": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "search_summary": {
      "type": "string",
      "maxLength": 1800
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    }
  }
}
