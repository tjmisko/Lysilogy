{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "authors",
        "year",
        "venue",
        "identifiers",
        "publication_state",
        "evidence",
        "confidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "As printed, without line-break hyphens."
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "affiliation"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "As printed."
              },
              "affiliation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "description": "All authors, in printed order."
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doi",
            "arxiv"
          ],
          "properties": {
            "doi": {
              "type": [
                "string",
                "null"
              ]
            },
            "arxiv": {
              "type": [
                "string",
                "null"
              ],
              "description": "arXiv identifier without the 'arXiv:' prefix."
            }
          }
        },
        "publication_state": {
          "type": "string",
          "enum": [
            "preprint",
            "published",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "page"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "description": "Copied exactly from the page text, 8 to 300 characters."
              },
              "page": {
                "type": "integer",
                "description": "1-based page number."
              }
            },
            "description": "A verbatim passage from the paper and the page it is on."
          },
          "description": "Verbatim support. Empty only when the item is a model judgment."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "How sure you are that this item is correct."
        }
      }
    }
  },
  "description": "The paper's identity."
}
