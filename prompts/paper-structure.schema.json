{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "claims", "glossary", "caveats", "reading_path"],
  "properties": {
    "sections": {
      "type": "array",
      "description": "Coherent topic-based reading units, usually 1–2 pages and generally 1–5 pages of actual content. Keep related parent headings, variants, and examples in one unit. Use the document-specific section budget; the schema ceiling is not a target. Preserve increasing PDF reading order, non-overlapping exact source spans, and matching page endpoints.",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "kind", "family", "pages", "summary", "digest", "source_span", "key_quotes", "related_terms", "tile_width", "tile_height"],
        "properties": {
          "title": { "type": "string" },
          "kind": { "enum": ["abstract", "background", "research_question", "theory", "methods", "data", "results", "discussion", "limitations", "conclusion", "references", "appendix", "other"] },
          "family": { "enum": ["context", "question", "method", "evidence", "interpretation", "caveat", "reference"] },
          "pages": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 }
            }
          },
          "summary": { "type": "string" },
          "digest": { "type": "string" },
          "source_span": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_text", "start_page", "end_text", "end_page"],
            "properties": {
              "start_text": { "type": "string" },
              "start_page": { "type": "integer", "minimum": 1 },
              "end_text": { "type": "string" },
              "end_page": { "type": "integer", "minimum": 1 }
            }
          },
          "key_quotes": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "page", "explanation", "significance"],
              "properties": {
                "text": { "type": "string" },
                "page": { "type": "integer", "minimum": 1 },
                "explanation": { "type": "string" },
                "significance": { "enum": ["thesis", "definition", "evidence", "qualification", "turning_point"] }
              }
            }
          },
          "related_terms": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string" }
          },
          "tile_width": { "type": "integer", "minimum": 1, "maximum": 4 },
          "tile_height": { "type": "integer", "minimum": 1, "maximum": 2 }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "support", "strength", "section_ids"],
        "properties": {
          "statement": { "type": "string" },
          "support": { "type": "string" },
          "strength": { "enum": ["speculative", "suggestive", "supported", "strong"] },
          "section_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "glossary": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "plain_language", "technical_definition", "why_it_matters", "section_ids"],
        "properties": {
          "term": { "type": "string" },
          "plain_language": { "type": "string" },
          "technical_definition": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "section_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" }
    },
    "reading_path": {
      "type": "array",
      "maxItems": 18,
      "items": { "type": "string" }
    }
  }
}
