{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sections"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outline_first",
          "outline_last",
          "pages",
          "source_span",
          "question",
          "summary",
          "title",
          "kind",
          "family"
        ],
        "properties": {
          "outline_first": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Index of the first outline entry in the unit; null when no outline was given."
          },
          "outline_last": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Index of the last outline entry in the unit; null when no outline was given."
          },
          "pages": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "description": "First 1-based PDF page."
              },
              "end": {
                "type": "integer",
                "description": "Last 1-based PDF page."
              }
            }
          },
          "source_span": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_text",
              "start_page",
              "end_text",
              "end_page"
            ],
            "properties": {
              "start_text": {
                "type": "string",
                "description": "A short verbatim phrase from where the unit begins."
              },
              "start_page": {
                "type": "integer"
              },
              "end_text": {
                "type": "string",
                "description": "A short verbatim phrase from where the unit ends."
              },
              "end_page": {
                "type": "integer"
              }
            }
          },
          "question": {
            "type": "string",
            "description": "Write this first: the one question every part of this unit helps answer. If you cannot write one question, change the range."
          },
          "summary": {
            "type": "string",
            "description": "One or two sentences that synthesize the whole unit."
          },
          "title": {
            "type": "string",
            "description": "Written after the question: a short title by role. Setup and method units name what they set up; result and interpretation units state the finding. Not a breadcrumb of the paper's own headings, and not two topics joined by 'and'."
          },
          "kind": {
            "type": "string",
            "enum": [
              "abstract",
              "background",
              "research_question",
              "theory",
              "methods",
              "data",
              "results",
              "discussion",
              "limitations",
              "conclusion",
              "references",
              "appendix",
              "other"
            ]
          },
          "family": {
            "type": "string",
            "enum": [
              "context",
              "question",
              "method",
              "evidence",
              "interpretation",
              "caveat",
              "reference"
            ]
          }
        }
      },
      "description": "Reading units that each answer one question, usually one to five pages of content. Increasing PDF order, non-overlapping spans, covering the main text."
    }
  },
  "description": "The paper's reading map."
}
