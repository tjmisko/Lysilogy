{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_notes"
  ],
  "properties": {
    "context_notes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_ids",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 700
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "before",
              "after"
            ]
          }
        }
      }
    }
  }
}
