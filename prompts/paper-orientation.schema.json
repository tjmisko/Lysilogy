{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["thesis", "author_abstract", "prerequisites"],
  "properties": {
    "thesis": { "type": "string", "maxLength": 600 },
    "author_abstract": { "type": ["string", "null"], "maxLength": 12000 },
    "prerequisites": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" }
    }
  }
}
