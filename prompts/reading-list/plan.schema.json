{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics",
    "topic_edges",
    "assumed_known"
  ],
  "properties": {
    "topics": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "summary",
          "claims",
          "graph_works"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "authors",
                "year",
                "venue",
                "doi",
                "arxiv",
                "role",
                "rationale",
                "context_links"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "venue": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "doi": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "arxiv": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "foundation",
                    "core",
                    "survey",
                    "frontier"
                  ]
                },
                "rationale": {
                  "type": "string"
                },
                "context_links": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "work_id",
                      "relation",
                      "note"
                    ],
                    "properties": {
                      "work_id": {
                        "type": "string"
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "builds_on",
                          "extends",
                          "contrasts",
                          "same_method",
                          "same_problem"
                        ]
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "graph_works": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "work_id",
                "role",
                "rationale",
                "context_links"
              ],
              "properties": {
                "work_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "foundation",
                    "core",
                    "survey",
                    "frontier"
                  ]
                },
                "rationale": {
                  "type": "string"
                },
                "context_links": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "work_id",
                      "relation",
                      "note"
                    ],
                    "properties": {
                      "work_id": {
                        "type": "string"
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "builds_on",
                          "extends",
                          "contrasts",
                          "same_method",
                          "same_problem"
                        ]
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "topic_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "subtopic",
              "prerequisite"
            ]
          }
        }
      }
    },
    "assumed_known": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "reason",
          "evidence"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
