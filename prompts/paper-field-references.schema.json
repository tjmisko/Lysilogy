          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "description": "Every bibliography entry, in order."
    }
  },
  "description": "The paper's bibliography entries."
}
