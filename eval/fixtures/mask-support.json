{
  "format": "independent-mask-support-fixtures-v1",
  "issue": 111,
  "author": "/root/review_ready_prs",
  "scope": "Synthetic decoded opacity and binding invariants only; no K1 truth, original images, detector outputs, owner source or native execution used.",
  "coordinate_contract": "row-major u8; a nonzero sample owns its complete pixel cell. Bounds use integer pixel edges then x=a*(column/width)+c*(row/height)+e; y=b*(column/width)+d*(row/height)+f. All values 1..255 count equally for support.",
  "identity_contract": "samples_sha256 hashes exact row-major u8 bytes. Dimensions, component/alpha semantics, transform, attached-image identity and full ordered device-event provenance must also match; the sample digest alone is insufficient.",
  "support_claim": "Only tight axis-aligned candidate envelope; holes and disconnected interior are not asserted painted. Any extra crop is unsupported in this iteration.",
  "variant_encoding": "Apply each isolated variant to its original accepted scene only. value_ieee754 constructs the named nonfinite float in the native test harness; JSON itself remains strict. rehash_attached_mask=true updates sample/attached hash only after the specified valid sample change.",
